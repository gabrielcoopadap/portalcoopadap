@model Certificacao
@{
    ViewData["Title"] = Model.Nome;
    ViewData["MenuAtivo"] = "cert-ativas";
    var c = Model;
}
<div class="cert-modulo">
    <partial name="_Recursos" />
    <a class="cm-voltar" href="/certificacao/certificacoes">@Html.Icone("arrow_back") Certificações Ativas</a>

    <div class="cm-card cm-card--pad cm-cert-det" style="margin-bottom:20px">
        <span class="cm-avatar cm-avatar--g" style="background:@c.Cor">@c.Sigla</span>
        <div class="cm-cert-det__id">
            <h1 class="cm-titulo" style="font-size:28px">@c.Nome</h1>
            <p class="cm-ajuda" style="margin:2px 0 0">@c.Escopo</p>
        </div>
        @Html.Pilula(c.Status, Rotulos.EstiloStatusCertificacao(c.Status))
        <div class="cm-acoes">
            <a class="cm-btn cm-btn--contorno" href="/certificacao/requisitos?norma=@Uri.EscapeDataString(c.Nome == "CAFE Practices" ? "C.A.F.E. Practices" : c.Nome)">@Html.Icone("checklist") Requisitos</a>
            <button type="button" class="cm-btn cm-btn--contorno" data-abrir-modal="modal-certificacao">@Html.Icone("edit") Editar</button>
            <form method="post" action="/certificacao/certificacoes/@c.Id/excluir" data-confirmar="Excluir esta certificação?">
                @Html.AntiForgeryToken()
                <button type="submit" class="cm-btn cm-btn--perigo" title="Excluir">@Html.Icone("delete_outline")</button>
            </form>
        </div>
    </div>

    <section class="cm-indicadores">
        <div class="cm-card cm-indicador"><div class="cm-indicador__topo">Conformidade geral</div><div class="cm-indicador__valor" style="color:@c.Cor">@(c.Conformidade ?? 0)%</div></div>
        <div class="cm-card cm-indicador"><div class="cm-indicador__topo">Total de requisitos</div><div class="cm-indicador__valor">@(c.TotalRequisitos ?? 0)</div></div>
        <div class="cm-card cm-indicador"><div class="cm-indicador__topo">Próxima auditoria</div><div class="cm-indicador__valor cm-indicador__valor--data">@Rotulos.Data(c.ProximaAuditoria)</div><div class="cm-indicador__sub">@c.Organismo</div></div>
        <div class="cm-card cm-indicador"><div class="cm-indicador__topo">Válido até</div><div class="cm-indicador__valor cm-indicador__valor--data">@Rotulos.Data(c.ValidoAte)</div><div class="cm-indicador__sub">Última auditoria: @Rotulos.Data(c.UltimaAuditoria)</div></div>
    </section>

    <section class="cm-stats">
        <div class="cm-card cm-stat" style="--cor:#1f8a4c"><div class="cm-stat__valor">@(c.Conformes ?? 0)</div><div class="cm-stat__rotulo">Conformes</div></div>
        <div class="cm-card cm-stat" style="--cor:#b8860b"><div class="cm-stat__valor">@(c.Pendentes ?? 0)</div><div class="cm-stat__rotulo">Pendentes</div></div>
        <div class="cm-card cm-stat" style="--cor:#c0392b"><div class="cm-stat__valor">@(c.NaoConformes ?? 0)</div><div class="cm-stat__rotulo">Não conformes</div></div>
    </section>

    <section class="cm-card cm-card--pad">
        <h2 class="cm-card__titulo">@Html.Icone("bar_chart") Conformidade por Categoria</h2>
        @if (c.Categorias.Count == 0)
        {
            <p class="cm-ajuda">Sem categorias cadastradas. Use "Editar" para incluir.</p>
        }
        @foreach (var cat in c.Categorias)
        {
            var pct = (cat.Total ?? 0) == 0 ? 0 : (int)Math.Round((cat.Conformes ?? 0) * 100.0 / cat.Total!.Value);
            <div class="cm-catbar">
                <div class="cm-catbar__topo"><span>@cat.Nome</span><span class="cm-catbar__num">@(cat.Conformes ?? 0)/@(cat.Total ?? 0) req. <b style="color:@c.Cor">@pct%</b></span></div>
                <div class="cm-barra"><div class="cm-barra__fill" style="width:@(Math.Min(100, pct))%;background:@c.Cor"></div></div>
            </div>
        }
    </section>

    <partial name="_FormCertificacao" model="Model" />
</div>
<partial name="_Scripts" />
