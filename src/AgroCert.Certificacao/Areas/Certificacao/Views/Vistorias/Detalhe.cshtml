@model VistoriaDetalheViewModel
@{
    var v = Model.Vistoria;
    ViewData["Title"] = v.CodigoDocumento;
    ViewData["MenuAtivo"] = "cert-vistorias";
    var coresRisco = new Dictionary<string, string> { ["CRITICO"] = "#c0392b", ["ALTO"] = "#b8860b", ["MEDIO"] = "#1f6fb2", ["BAIXO"] = "#1f8a4c" };
}
<div class="cert-modulo">
    <partial name="_Recursos" />
    <a class="cm-voltar" href="/certificacao/vistorias">@Html.Icone("arrow_back") Vistorias</a>

    <div class="cm-topo">
        <div>
            <h1 class="cm-titulo">@Html.Icone("fact_check") @v.UnidadePropriedade</h1>
            <p class="cm-subtitulo">
                <span class="cm-codigo">@v.CodigoDocumento</span> · @Rotulos.RotuloTipoVistoria(v.Tipo) · @Rotulos.Data(v.DataVistoria)@(string.IsNullOrWhiteSpace(v.SetorArea) ? "" : " · " + v.SetorArea)
            </p>
        </div>
        <div class="cm-acoes">
            <a class="cm-btn cm-btn--contorno" href="/certificacao/vistorias/@v.Id/relatorio.pdf" target="_blank">@Html.Icone("picture_as_pdf") Relatório PDF</a>
            <button type="button" class="cm-btn cm-btn--primario" data-abrir-modal="modal-novo-apont">@Html.Icone("add") Novo Apontamento</button>
            <form method="post" action="/certificacao/vistorias/@v.Id/excluir" data-confirmar="Excluir esta vistoria e todos os seus apontamentos?">
                @Html.AntiForgeryToken()
                <button type="submit" class="cm-btn cm-btn--perigo" title="Excluir vistoria">@Html.Icone("delete_outline")</button>
            </form>
        </div>
    </div>

    <section class="cm-stats">
        <div class="cm-card cm-stat" style="--cor:#c0392b"><div class="cm-stat__valor">@v.Criticos</div><div class="cm-stat__rotulo">Críticos</div></div>
        <div class="cm-card cm-stat" style="--cor:#b8860b"><div class="cm-stat__valor">@v.Altos</div><div class="cm-stat__rotulo">Altos</div></div>
        <div class="cm-card cm-stat" style="--cor:#1f6fb2"><div class="cm-stat__valor">@v.Medios</div><div class="cm-stat__rotulo">Médios</div></div>
        <div class="cm-card cm-stat" style="--cor:#1f8a4c"><div class="cm-stat__valor">@v.Baixos</div><div class="cm-stat__rotulo">Baixos</div></div>
    </section>

    <section class="cm-card cm-card--pad">
        <h2 class="cm-card__titulo">@Html.Icone("report") Apontamentos (@v.TotalApontamentos)
            <span class="cm-contador" style="margin-left:auto">@v.EmAberto em aberto · @v.Encerrados encerrado(s)</span>
        </h2>
        @if (v.Apontamentos.Count == 0)
        {
            <div class="cm-vazio">Nenhum apontamento registrado nesta vistoria. Use "Novo Apontamento" para registrar uma não conformidade.</div>
        }
        <div class="cm-apont-grade">
            @foreach (var a in v.Apontamentos)
            {
                <article class="cm-card cm-apont" style="--cor:@coresRisco.GetValueOrDefault(a.GrauRisco, "#ccc")" data-abrir-modal="modal-apont-@a.Id" tabindex="0" role="button">
                    <div class="cm-apont__topo">
                        <span class="cm-apont__titulo">@a.Anomalia</span>
                        @Html.Pilula(Rotulos.RotuloGrauRisco(a.GrauRisco), Rotulos.EstiloGrauRisco(a.GrauRisco))
                    </div>
                    <div class="cm-apont__meta">
                        @if (!string.IsNullOrWhiteSpace(a.Localizacao)) { <span>@Html.Icone("place", "font-size:15px") @a.Localizacao</span> }
                        @if (a.Prazo.HasValue) { <span>@Html.Icone("event", "font-size:15px") Prazo: @Rotulos.Data(a.Prazo)</span> }
                        @if (a.RequisitoId.HasValue) { <span class="cm-tag cm-tag--verde" title="@a.RequisitoTitulo">@(a.RequisitoCodigo ?? "Requisito vinculado")</span> }
                    </div>
                    @Html.Pilula(a.Aberto ? "Em aberto" : "Encerrado", Rotulos.EstiloStatusApontamento(a.Status))
                </article>
            }
        </div>

        <div class="cm-assinaturas">
            <span>Responsável: <b>@(string.IsNullOrWhiteSpace(v.TecnicoResponsavel) ? "—" : v.TecnicoResponsavel)</b>@(string.IsNullOrWhiteSpace(v.CargoTecnico) ? "" : $" · {v.CargoTecnico}")</span>
            @if (!string.IsNullOrWhiteSpace(v.AprovadoPor))
            {
                <span>Aprovado por: <b>@v.AprovadoPor@(string.IsNullOrWhiteSpace(v.CargoAprovador) ? "" : $" ({v.CargoAprovador})")</b></span>
            }
            @if (!string.IsNullOrWhiteSpace(v.Motivo)) { <span>Motivo: <b>@v.Motivo</b></span> }
        </div>
    </section>

    @foreach (var a in v.Apontamentos)
    {
        <partial name="_ModalApontamento" model="a" />
    }

    <dialog class="cm-modal" id="modal-novo-apont" aria-labelledby="titulo-novo-apont">
        <form method="post" action="/certificacao/vistorias/@v.Id/apontamentos" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="cm-modal__cab">
                <h2 class="cm-modal__titulo" id="titulo-novo-apont">Novo Apontamento</h2>
                <button type="button" class="cm-icone-btn" data-fechar-modal aria-label="Fechar">@Html.Icone("close")</button>
            </div>
            <div class="cm-modal__corpo">
                <div class="cm-campo"><label for="ap-anom">Anomalia / não conformidade encontrada *</label><input id="ap-anom" class="cm-input" name="Anomalia" required placeholder="Ex: Ausência de EPI no depósito de agrotóxicos" /></div>
                <div class="cm-linha">
                    <div class="cm-campo"><label for="ap-local">Localização</label><input id="ap-local" class="cm-input" name="Localizacao" placeholder="Ex: Galpão 2" /></div>
                    <div class="cm-campo"><label for="ap-req">Requisito da certificação (opcional)</label>
                        <select id="ap-req" class="cm-select" name="RequisitoId">
                            <option value="">Nenhum</option>
                            @foreach (var r in Model.Requisitos.OrderBy(x => x.Tema).ThenBy(x => x.Titulo))
                            {
                                var refer = r.Referencias.FirstOrDefault();
                                <option value="@r.Id">@(refer is null ? "" : $"[{Rotulos.Sigla(refer.Norma)} {refer.Codigo}] ")@r.Titulo</option>
                            }
                        </select>
                    </div>
                </div>
                <span class="cm-rotulo">Grau de risco</span>
                <div class="cm-opcoes" style="margin-top:6px">
                    @foreach (var g in Rotulos.GrausRisco)
                    {
                        <input type="radio" id="grau-@g" name="GrauRisco" value="@g" checked="@(g == "MEDIO")" />
                        <label for="grau-@g" style="--cor:@Rotulos.EstiloGrauRisco(g).Cor">@Rotulos.RotuloGrauRisco(g)</label>
                    }
                </div>
                <div class="cm-linha">
                    <div class="cm-campo"><label for="ap-enc">Situação encontrada</label><textarea id="ap-enc" class="cm-textarea" name="SituacaoEncontrada"></textarea></div>
                    <div class="cm-campo"><label for="ap-reqd">Situação requerida</label><textarea id="ap-reqd" class="cm-textarea" name="SituacaoRequerida"></textarea></div>
                </div>
                <div class="cm-campo"><label for="ap-risco">Risco associado</label><textarea id="ap-risco" class="cm-textarea" name="RiscoAssociado" placeholder="Ex: Risco de contaminação e não conformidade com a norma X"></textarea></div>
                <div class="cm-linha">
                    <div class="cm-campo"><label for="ap-prazo">Prazo para regularização</label><input id="ap-prazo" type="date" class="cm-input" name="Prazo" /></div>
                    <div class="cm-campo"><label for="ap-resp">Responsável pela execução</label><input id="ap-resp" class="cm-input" name="ResponsavelExecucao" /></div>
                </div>
                <div class="cm-linha">
                    <div class="cm-campo"><label for="ap-f1">Foto — situação encontrada</label><input id="ap-f1" type="file" accept="image/*" class="cm-input" name="ImagemEncontrada" /></div>
                    <div class="cm-campo"><label for="ap-f2">Foto — situação requerida (referência)</label><input id="ap-f2" type="file" accept="image/*" class="cm-input" name="ImagemRequerida" /></div>
                </div>
            </div>
            <div class="cm-modal__acoes">
                <button type="button" class="cm-btn cm-btn--contorno" data-fechar-modal>Cancelar</button>
                <button type="submit" class="cm-btn cm-btn--primario" data-carregando="Salvando...">Registrar Apontamento</button>
            </div>
        </form>
    </dialog>
</div>
<partial name="_Scripts" />
