@model List<PropriedadeDto>
@{
    ViewData["Title"] = "Monitoramento Ambiental";
    ViewData["MenuAtivo"] = "cert-ambiental";
}
<div class="cert-modulo">
    <partial name="_Recursos" />

    <div class="cm-topo">
        <div>
            <h1 class="cm-titulo">@Html.Icone("eco") Monitoramento Ambiental</h1>
            <p class="cm-subtitulo">Desmatamento e vegetação por propriedade, a partir do código do CAR</p>
        </div>
        <div class="cm-acoes">
            <button type="button" class="cm-btn cm-btn--primario" data-abrir-modal="modal-propriedade">@Html.Icone("add") Nova Propriedade</button>
        </div>
    </div>

    @if (Model.Count == 0)
    {
        <div class="cm-vazio">Nenhuma propriedade cadastrada ainda. Cadastre uma pelo código do CAR.</div>
    }

    <div class="cm-grade">
        @foreach (var p in Model)
        {
            <article class="cm-card cm-cert">
                <div class="cm-cert__topo">
                    <span class="cm-avatar" style="background:#5e9a42">@Html.Icone("agriculture")</span>
                    <div class="cm-cert__id">
                        <div class="cm-cert__nome">@p.Nome</div>
                        <div class="cm-cert__escopo" title="@p.CarCodigo">CAR: @p.CarCodigo</div>
                    </div>
                    <form method="post" action="/certificacao/ambiental/@p.Id/excluir" data-confirmar="Excluir esta propriedade e seus alertas?">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="cm-icone-btn" title="Excluir">@Html.Icone("delete_outline")</button>
                    </form>
                </div>
                <div class="cm-detalhes">
                    <div><span class="cm-dl">Área do imóvel</span><span class="cm-dv">@(p.AreaHa.HasValue ? Rotulos.Numero(p.AreaHa) + " ha" : "não disponível")</span></div>
                    <div><span class="cm-dl">Município</span><span class="cm-dv">@(p.Municipio is null ? "—" : $"{p.Municipio}/{p.Uf}")</span></div>
                </div>
                <div class="cm-rodape-card"><a href="/certificacao/ambiental/@p.Id">Ver mapa, alertas e NDVI →</a></div>
            </article>
        }
    </div>

    <dialog class="cm-modal" id="modal-propriedade" aria-labelledby="titulo-modal-prop">
        <form method="post" action="/certificacao/ambiental">
            @Html.AntiForgeryToken()
            <div class="cm-modal__cab">
                <h2 class="cm-modal__titulo" id="titulo-modal-prop">Nova Propriedade (CAR)</h2>
                <button type="button" class="cm-icone-btn" data-fechar-modal aria-label="Fechar">@Html.Icone("close")</button>
            </div>
            <div class="cm-modal__corpo">
                <div class="cm-campo"><label for="p-nome">Nome da propriedade *</label><input id="p-nome" class="cm-input" name="Nome" required placeholder="Ex: Fazenda São João" /></div>
                <div class="cm-campo"><label for="p-car">Código do CAR *</label><input id="p-car" class="cm-input" name="CarCodigo" required placeholder="MG-XXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX" /></div>
                <label class="cm-check"><input type="checkbox" name="geometriaManual" value="true" data-mostrar-se-marcado="bloco-geo" data-esconder-se-marcado="bloco-sicar" /> Ainda não tenho acesso à API do SICAR — vou colar a geometria manualmente</label>
                <p class="cm-ajuda" id="bloco-sicar">A geometria do imóvel é buscada automaticamente no SICAR a partir do código do CAR.</p>
                <div class="cm-campo" id="bloco-geo" hidden>
                    <label for="p-geo">Geometria (GeoJSON — Polygon, MultiPolygon, Feature ou FeatureCollection)</label>
                    <textarea id="p-geo" class="cm-textarea cm-textarea--geo" name="GeoJson" placeholder='{"type":"Polygon","coordinates":[[[...]]]}'></textarea>
                    <p class="cm-ajuda">Dá pra exportar a geometria pela Consulta Pública do SICAR (shapefile convertido em GeoJSON) e colar aqui — todas as feições são unidas num único polígono.</p>
                </div>
            </div>
            <div class="cm-modal__acoes">
                <button type="button" class="cm-btn cm-btn--contorno" data-fechar-modal>Cancelar</button>
                <button type="submit" class="cm-btn cm-btn--primario" data-carregando="Consultando...">Cadastrar</button>
            </div>
        </form>
    </dialog>
</div>
<partial name="_Scripts" />
