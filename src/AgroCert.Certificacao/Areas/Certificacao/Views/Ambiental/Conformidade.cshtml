@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Hosting
@model RelatorioConformidadeDto
@inject IWebHostEnvironment Ambiente
@{
    Layout = null;
    var r = Model;
    var pt = CultureInfo.GetCultureInfo("pt-BR");
    var inv = CultureInfo.InvariantCulture;
    string Ha(decimal? v) => v is null ? "—" : v.Value.ToString(Math.Abs(v.Value) < 10 ? "N1" : "N0", pt) + " ha";
    string Pct(decimal a, decimal b) => b > 0 ? (100 * a / b).ToString("N0", pt) + "%" : "—";
    var logo = new[] { "logo-coopadap.svg", "logo-coopadap.png", "logo-coopadap.jpg" }
        .FirstOrDefault(n => Ambiente.WebRootFileProvider.GetFileInfo("img/" + n).Exists);
    var hoje = DateTime.Now.ToString("dd/MM/yyyy");
    var anos = r.AnosComparados;
    var ult = r.AnoAtual;
    string RotuloStatus(StatusCriterio s) => s switch
    {
        StatusCriterio.Conforme => "Conforme",
        StatusCriterio.Verificar => "Verificar",
        StatusCriterio.IndicioNaoConformidade => "Indício de não conformidade",
        _ => "Sem dados",
    };
    string ClasseStatus(StatusCriterio s) => s switch
    {
        StatusCriterio.Conforme => "ok", StatusCriterio.Verificar => "ver", StatusCriterio.IndicioNaoConformidade => "nc", _ => "sd",
    };
    string IconeStatus(StatusCriterio s) => s switch
    {
        StatusCriterio.Conforme => "check_circle", StatusCriterio.Verificar => "error_outline", StatusCriterio.IndicioNaoConformidade => "cancel", _ => "help_outline",
    };
    string CorMarco(string m) => m == "2020" ? "#d7261e" : m == "2014" ? "#f07d1a" : "#f2c81d";
    var piores = r.Criterios.Count(c => c.Status == StatusCriterio.IndicioNaoConformidade);
    var verificar = r.Criterios.Count(c => c.Status == StatusCriterio.Verificar);
    var semDados = r.Criterios.Count(c => c.Status == StatusCriterio.SemDados);
    var (conclusaoClasse, conclusao) = piores > 0
        ? ("nc", $"Há {piores} critério(s) com indício de não conformidade. Confira as áreas indicadas em campo e reúna os documentos (autorizações, termos de regularização) antes da auditoria.")
        : verificar > 0 ? ("ver", $"Nenhum indício de não conformidade, mas {verificar} critério(s) precisam de verificação ou de documento.")
        : semDados > 0 ? ("sd", $"Nenhum problema encontrado nos critérios avaliados; {semDados} critério(s) não puderam ser avaliados por falta de dados.")
        : ("ok", "Nenhuma conversão de vegetação nativa nem sobreposição com unidade de conservação foi encontrada nas fontes consultadas.");

    string Url(string tipo, int ano, double[] c) =>
        $"/certificacao/ambiental/{r.PropriedadeId}/conformidade/satelite?tipo={tipo}&ano={ano}&caixa={string.Join(",", c.Select(v => v.ToString("0.000000", inv)))}";

    var dadosMapa = JsonSerializer.Serialize(new
    {
        imovel = r.GeoJson,
        rl = r.GeoJsonReservaLegal,
        app = r.GeoJsonApp,
        ucs = r.UcsGeoJson,
        mudanca = r.MapaMudanca,
        limites = r.MapaMudancaLimites,
        areas = r.Areas.Select(a => new { n = a.Numero, lat = a.Lat, lon = a.Lon, cor = CorMarco(a.Marco) }),
    });
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Conformidade ambiental — @r.Nome</title>
    <link rel="stylesheet" href="~/_content/AgroCert.Certificacao/lib/material-icons/material-icons.css" />
    <link rel="stylesheet" href="~/_content/AgroCert.Certificacao/lib/leaflet/leaflet.css" />
    <link rel="stylesheet" href="~/_content/AgroCert.Certificacao/css/ambiental-relatorio.css" asp-append-version="true" />
</head>
<body>
    <div class="rc-barra">
        <a class="rc-btn rc-btn--texto" href="/certificacao/ambiental/@r.PropriedadeId"><span class="material-icons">arrow_back</span> Voltar ao imóvel</a>
        <span class="rc-barra__dica" id="rc-dica">Carregando imagens…</span>
        <button type="button" class="rc-btn" id="rc-imprimir"><span class="material-icons">picture_as_pdf</span> Gerar PDF</button>
    </div>

    <main class="rc-folha">
        <header class="rc-cab">
            @if (logo is not null)
            {
                <img class="rc-logo" src="~/img/@logo" alt="Coopadap" />
            }
            else
            {
                <div class="rc-logo-txt"><span class="material-icons">spa</span> coopadap</div>
            }
            <div class="rc-cab__tit">
                <div class="rc-cab__h1">Relatório de Conformidade Ambiental</div>
                <div class="rc-cab__sub">Desmatamento por data de corte · Unidades de conservação · emitido em @hoje</div>
            </div>
        </header>

        <section class="rc-imovel">
            <div class="rc-imovel__nome">@r.Nome</div>
            <div class="rc-imovel__dados">
                <span><b>CAR</b> @r.Car</span>
                @if (r.Municipio is not null) { <span><b>Município</b> @r.Municipio/@r.Uf</span> }
                <span><b>Área</b> @Ha(r.AreaHa)</span>
                @if (r.AreaReservaLegalHa is not null) { <span><b>Reserva Legal</b> @Ha(r.AreaReservaLegalHa)</span> }
                @if (r.AreaAppHa is not null) { <span><b>APP</b> @Ha(r.AreaAppHa)</span> }
            </div>
        </section>

        <div class="rc-conclusao rc-conclusao--@conclusaoClasse">@conclusao</div>

        <h2 class="rc-h2"><span class="material-icons">fact_check</span> Parecer por critério</h2>
        <table class="rc-tab rc-parecer">
            <thead><tr><th>Norma</th><th>Critério</th><th>Situação</th><th>O que foi encontrado</th></tr></thead>
            <tbody>
                @foreach (var c in r.Criterios)
                {
                    <tr>
                        <td class="rc-norma">@c.Norma</td>
                        <td><b>@c.Titulo</b><div class="rc-sub">@c.Exigencia</div></td>
                        <td><span class="rc-st rc-st--@ClasseStatus(c.Status)"><span class="material-icons">@IconeStatus(c.Status)</span>@RotuloStatus(c.Status)</span></td>
                        <td>@c.Resultado @if (c.Observacao is not null) { <div class="rc-sub">@c.Observacao</div> }</td>
                    </tr>
                }
            </tbody>
        </table>

        @if (r.Marcos.Count > 0)
        {
            <p class="rc-nota">
                Mapas do MapBiomas usados:
                @string.Join(" · ", r.Marcos.Select(m => $"{m.Rotulo} → mapa de {(m.AnoUsado?.ToString() ?? "—")}{(m.Aproximado ? " (aprox.)" : "")}")) · situação atual → mapa de @ult.
            </p>
        }

        @if (r.MapaMudanca is not null)
        {
            <h2 class="rc-h2"><span class="material-icons">map</span> Mapa do imóvel — o que mudou desde @(r.Marcos.FirstOrDefault(m => m.Chave == "2008")?.AnoUsado ?? anos.FirstOrDefault())</h2>
            <div class="rc-mapa" id="rc-mapa"></div>
            <div class="rc-legenda">
                @foreach (var l in r.LegendaMudanca) { <span><i style="background:@l.Cor"></i>@l.Texto</span> }
                <span><i class="rc-l-imovel"></i>Limite do imóvel</span>
                <span><i class="rc-l-rl"></i>Reserva Legal</span>
                <span><i class="rc-l-app"></i>APP</span>
                @if (r.UcsGeoJson is not null) { <span><i class="rc-l-uc"></i>Unidade de conservação</span> }
            </div>
            <div class="rc-numeros">
                <div><b>@Ha(r.ConversaoTotalHa)</b><span>convertidos desde @(r.Marcos.FirstOrDefault(m => m.Chave == "2008")?.AnoUsado) em @r.Areas.Count área(s)</span></div>
                <div><b>@Ha(r.RegeneracaoHa)</b><span>voltaram a ser vegetação nativa</span></div>
                <div><b>@(r.PorArea.FirstOrDefault() is { } t && ult is int u ? Ha(t.NativaHa.GetValueOrDefault(u)) : "—")</b><span>de vegetação nativa em @ult</span></div>
                <div><b>@r.Alertas.Count</b><span>alerta(s) do MapBiomas Alerta</span></div>
            </div>
        }

        @if (r.PorArea.Count > 0)
        {
            <section class="rc-bloco">
                <h2 class="rc-h2"><span class="material-icons">table_chart</span> Vegetação nativa por área do imóvel</h2>
                <table class="rc-tab rc-tab--num">
                    <thead>
                        <tr><th>Área</th><th>Tamanho</th>@foreach (var a in anos) { <th>@a</th> }<th>Variação</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in r.PorArea)
                        {
                            var v0 = l.NativaHa.GetValueOrDefault(anos[0]);
                            var v1 = l.NativaHa.GetValueOrDefault(anos[^1]);
                            var dv = v1 - v0;
                            <tr>
                                <td><b>@l.Area</b></td>
                                <td>@Ha(l.AreaHa)</td>
                                @foreach (var a in anos)
                                {
                                    <td>@Ha(l.NativaHa.GetValueOrDefault(a))<div class="rc-sub">@Pct(l.NativaHa.GetValueOrDefault(a), l.AreaHa)</div></td>
                                }
                                <td class="@(dv < -0.5m ? "rc-neg" : dv > 0.5m ? "rc-pos" : "")">@(dv > 0 ? "+" : "")@Ha(dv)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="rc-nota">Vegetação nativa = formações florestal, savânica e campestre, campos alagados e afloramentos (classes naturais do MapBiomas). Áreas medidas pelos pixels de 30 m do mapa, por isso diferem um pouco das áreas declaradas no CAR.</p>

                @if (r.Classes.Count > 0)
                {
                    <h3 class="rc-h3">Uso do solo dentro do imóvel</h3>
                    <table class="rc-tab rc-tab--num rc-tab--classes">
                        <thead><tr><th>Classe (MapBiomas)</th>@foreach (var a in anos) { <th>@a</th> }</tr></thead>
                        <tbody>
                            @foreach (var c in r.Classes.Take(12))
                            {
                                <tr><td><i class="rc-q" style="background:@c.Cor"></i>@c.Nome @if (c.Natural) { <span class="rc-nat">nativa</span> }</td>@foreach (var a in anos) { <td>@Ha(c.Ha.GetValueOrDefault(a))</td> }</tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        }

        @if (r.Imovel is not null)
        {
            <section class="rc-bloco">
                <h2 class="rc-h2"><span class="material-icons">compare</span> Imóvel inteiro — antes × depois</h2>
                @Figuras(r.Imovel, true, "MapBiomas (classes de uso)", r.Imovel.MapBiomas.Select(m => (m.Ano.ToString(), m.DataUri)).ToList())
                @if (r.CopernicusConfigurado)
                {
                    @Figuras(r.Imovel, true, "Sentinel-2 — cor real (jun–set)", r.AnosSatelite.Select(a => (a.ToString(), (string?)Url("cor", a, r.Imovel.Caixa))).ToList())
                    @Figuras(r.Imovel, true, "Sentinel-2 — NDVI (verde = vegetação, vermelho = solo)", r.AnosSatelite.Select(a => (a.ToString(), (string?)Url("ndvi", a, r.Imovel.Caixa))).ToList())
                }
                @LegendaClasses(r.Classes)
            </section>
        }

        @if (r.MapaMudanca is not null)
        {
            <section class="rc-bloco">
                <h2 class="rc-h2"><span class="material-icons">crop_free</span> Áreas onde a vegetação nativa foi convertida</h2>
                @if (r.Areas.Count == 0)
                {
                    <p class="rc-texto rc-texto--ok"><span class="material-icons">verified</span> Nenhuma área de vegetação nativa convertida em uso agropecuário depois de @(r.Marcos.FirstOrDefault(m => m.Chave == "2008")?.AnoUsado) dentro do imóvel (manchas a partir de 0,4 ha).</p>
                }
                else
                {
                    <p class="rc-texto">Cada área abaixo era vegetação nativa num dos marcos e no mapa de @ult tem uso agropecuário. Compare as imagens de antes e depois; o contorno vermelho marca a área. Confirme em campo — o mapa de 30 m pode errar em bordas e em áreas de cerrado ralo.</p>
                    <table class="rc-tab rc-tab--num rc-resumo-areas">
                        <thead><tr><th>Nº</th><th>Área</th><th>Quando</th><th>Antes → depois</th><th>Na RL</th><th>Na APP</th><th>Período</th></tr></thead>
                        <tbody>
                            @foreach (var a in r.Areas)
                            {
                                <tr>
                                    <td><span class="rc-num" style="background:@CorMarco(a.Marco)">@a.Numero</span></td>
                                    <td><b>@Ha(a.AreaHa)</b></td>
                                    <td>@(a.AnoNatural is null ? "—" : $"{a.AnoNatural} → {a.AnoConvertida}")</td>
                                    <td>@a.ClasseAntes → @a.ClasseDepois</td>
                                    <td>@(a.NaReservaLegalHa > 0 ? Ha(a.NaReservaLegalHa) : "—")</td>
                                    <td>@(a.NaAppHa > 0 ? Ha(a.NaAppHa) : "—")</td>
                                    <td>@a.Periodo</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @foreach (var a in r.Areas.Where(a => a.Janela.MapBiomas.Count > 0))
                    {
                        <article class="rc-area">
                            <div class="rc-area__cab">
                                <span class="rc-num rc-num--g" style="background:@CorMarco(a.Marco)">@a.Numero</span>
                                <div>
                                    <div class="rc-area__tit">Área @a.Numero — @Ha(a.AreaHa) · @a.Periodo</div>
                                    <div class="rc-sub">
                                        @(a.AnoNatural is null ? "" : $"Vegetação nativa ({a.ClasseAntes}) em {a.AnoNatural}; ")@a.ClasseDepois em @(a.AnoConvertida ?? ult).
                                        @if (a.NaReservaLegalHa > 0) { <b> @Ha(a.NaReservaLegalHa) dentro da Reserva Legal.</b> }
                                        @if (a.NaAppHa > 0) { <b> @Ha(a.NaAppHa) dentro de APP.</b> }
                                        Coordenadas: @a.Lat.ToString("0.00000", inv), @a.Lon.ToString("0.00000", inv)
                                    </div>
                                </div>
                            </div>
                            @Figuras(a.Janela, false, "MapBiomas", a.Janela.MapBiomas.Select(m => (m.Ano.ToString(), m.DataUri)).ToList())
                            @if (r.CopernicusConfigurado && a.ComSatelite)
                            {
                                @Figuras(a.Janela, false, "Sentinel-2 — cor real", r.AnosSatelite.Select(y => (y.ToString(), (string?)Url("cor", y, a.Janela.Caixa))).ToList())
                                @Figuras(a.Janela, false, "Sentinel-2 — NDVI", r.AnosSatelite.Select(y => (y.ToString(), (string?)Url("ndvi", y, a.Janela.Caixa))).ToList())
                            }
                        </article>
                    }
                    @LegendaClasses(r.Classes)
                }
            </section>
        }

        <section class="rc-bloco">
            <h2 class="rc-h2"><span class="material-icons">park</span> Unidades de conservação e zonas de amortecimento</h2>
            @if (!r.UcComDados)
            {
                <p class="rc-texto">Camada de unidades de conservação não carregada. Coloque o shapefile do CNUC (MMA) — pode ser o .zip baixado — na pasta <code>@r.PastaUcs</code>.</p>
            }
            else if (r.Ucs.Count == 0)
            {
                <p class="rc-texto rc-texto--ok"><span class="material-icons">verified</span> Nenhuma unidade de conservação a menos de 10 km do imóvel.</p>
            }
            else
            {
                <table class="rc-tab">
                    <thead><tr><th>Unidade de conservação</th><th>Grupo</th><th>Distância</th><th>Situação</th></tr></thead>
                    <tbody>
                        @foreach (var u in r.Ucs)
                        {
                            <tr>
                                <td><b>@u.Nome</b>@if (u.Categoria is not null) { <div class="rc-sub">@u.Categoria@(u.Esfera is null ? "" : " · " + u.Esfera)</div> }</td>
                                <td>@(u.EhZonaAmortecimento ? "Zona de amortecimento" : u.Grupo)</td>
                                <td>@(u.Dentro ? (u.AreaDentroHa is null ? "dentro" : $"dentro ({Ha(u.AreaDentroHa)})") : u.DistanciaM < 1000 ? $"{u.DistanciaM:0} m" : (u.DistanciaM / 1000).ToString("0.0", pt) + " km")</td>
                                <td><span class="rc-st rc-st--@ClasseStatus(u.Status)"><span class="material-icons">@IconeStatus(u.Status)</span>@RotuloStatus(u.Status)</span><div class="rc-sub">@u.Situacao</div></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <p class="rc-nota">Quando a UC não tem zona de amortecimento definida, foi usada a faixa de @((r.RaioAmortecimentoM / 1000.0).ToString("0.#", pt)) km (Resolução CONAMA 428/2010). APA e RPPN não têm zona de amortecimento (Lei 9.985/2000, art. 25). A produção dentro de UC de uso sustentável pode ser permitida pelo plano de manejo.</p>
        </section>

        <section class="rc-bloco">
            <h2 class="rc-h2"><span class="material-icons">notification_important</span> Alertas de desmatamento (MapBiomas Alerta)</h2>
            @if (r.Alertas.Count == 0)
            {
                <p class="rc-texto rc-texto--ok"><span class="material-icons">verified</span> Nenhum alerta registrado dentro do imóvel.</p>
            }
            else
            {
                <table class="rc-tab">
                    <thead><tr><th>Alerta</th><th>Data</th><th>Área</th><th>Onde</th><th>Antes × depois</th></tr></thead>
                    <tbody>
                        @foreach (var a in r.Alertas)
                        {
                            <tr>
                                <td><b>@a.CodigoAlerta</b><div class="rc-sub">@a.ClasseDesmatamento</div></td>
                                <td>@Rotulos.Data(a.DataDeteccao)</td>
                                <td>@Ha(a.AreaHa)</td>
                                <td>@(a.DentroReservaLegal == true ? "Reserva Legal " : "")@(a.DentroApp == true ? "APP" : "")</td>
                                <td class="rc-alerta-imgs">
                                    @if (a.ImagemAntesUrl is not null) { <img src="@a.ImagemAntesUrl" alt="Antes" /> }
                                    @if (a.ImagemDepoisUrl is not null) { <img src="@a.ImagemDepoisUrl" alt="Depois" /> }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (r.Ndvi.Count > 0)
        {
            var serie = r.Ndvi.Where(n => n.NdviMedio is not null).ToList();
            <section class="rc-bloco">
                <h2 class="rc-h2"><span class="material-icons">grass</span> NDVI mensal do imóvel (Sentinel-2)</h2>
                <div class="rc-ndvi">
                    @foreach (var n in serie)
                    {
                        var v = (double)n.NdviMedio!.Value;
                        var cls = Rotulos.ClassificarNdvi(n.NdviMedio);
                        <div class="rc-ndvi__barra" title="@Rotulos.MesAno(n.DataImagem): @v.ToString("0.00", pt)">
                            <span class="rc-ndvi__v">@v.ToString("0.00", pt)</span>
                            <i style="height:@((Math.Clamp(v, 0, 1) * 100).ToString("0", inv))%;background:@cls.Cor"></i>
                            <span class="rc-ndvi__m">@Rotulos.MesAno(n.DataImagem)</span>
                        </div>
                    }
                </div>
                <p class="rc-nota">NDVI médio dentro do limite do imóvel. Quedas bruscas que não voltam no ano seguinte merecem verificação; quedas na seca e na colheita são normais.</p>
            </section>
        }

        <section class="rc-bloco">
            <h2 class="rc-h2"><span class="material-icons">menu_book</span> Como foi feito</h2>
            <ul class="rc-lista">
                <li>Os mapas anuais do MapBiomas de cada data de corte foram comparados pixel a pixel com o mapa mais recente, dentro do limite do CAR. Conta como conversão o pixel que era vegetação nativa no marco e tem uso agropecuário (pastagem, lavoura, silvicultura, mosaico de usos, área urbana ou mineração) no mapa atual.</li>
                <li>Pixels vizinhos foram agrupados em áreas; manchas menores que 0,4 ha foram desconsideradas por serem, em geral, erro de classificação.</li>
                <li>As imagens Sentinel-2 são da estação seca (junho a setembro) de cada ano, na cena com menos nuvem. A de 2016 é a mais antiga disponível com 10 m.</li>
                <li>A autorização de supressão (ASV/DAIA) não aparece em mapas: para as áreas convertidas após 22/07/2008 é preciso apresentar o documento.</li>
            </ul>
            <h3 class="rc-h3">Fontes</h3>
            <ul class="rc-lista">@foreach (var f in r.Fontes) { <li>@f</li> }</ul>
            @if (r.Avisos.Count > 0)
            {
                <h3 class="rc-h3">Observações</h3>
                <ul class="rc-lista rc-lista--aviso">@foreach (var a in r.Avisos) { <li>@a</li> }</ul>
            }
            <p class="rc-nota">Relatório de monitoramento baseado em dados públicos de sensoriamento remoto. Não substitui vistoria de campo nem constitui certificação ou parecer jurídico.</p>
            <div class="rc-assinaturas"><div>Responsável técnico</div><div>Produtor</div></div>
        </section>
        <div class="rc-rodape">@r.Nome · CAR @r.Car · emitido em @hoje</div>
    </main>

    <script type="application/json" id="rc-dados">@Html.Raw(dadosMapa.Replace("</", "<\\/"))</script>
    <script src="~/_content/AgroCert.Certificacao/lib/leaflet/leaflet.js"></script>
    <script src="~/_content/AgroCert.Certificacao/js/ambiental-relatorio.js" asp-append-version="true"></script>
</body>
</html>

@functions {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static string Num(double v) => v.ToString("0.######", Inv);

    private Microsoft.AspNetCore.Html.IHtmlContent Figuras(JanelaImagem j, bool imovel, string titulo, List<(string Rotulo, string? Src)> imagens)
    {
        var c = j.Caixa;
        var vb = $"{Num(c[0])} {Num(-c[3])} {Num(c[2] - c[0])} {Num(c[3] - c[1])}";
        var sb = new System.Text.StringBuilder();
        sb.Append("<div class=\"rc-figs\"><div class=\"rc-figs__tit\">").Append(System.Net.WebUtility.HtmlEncode(titulo)).Append("</div><div class=\"rc-figs__linha\">");
        foreach (var (rot, src) in imagens)
        {
            sb.Append("<figure class=\"rc-fig\"><div class=\"rc-fig__img\" style=\"aspect-ratio:").Append(j.ProporcaoLarguraAltura.ToString("0.####", Inv)).Append("\">");
            if (src is null) sb.Append("<div class=\"rc-fig__falta\">sem mapa</div>");
            else sb.Append("<img src=\"").Append(System.Net.WebUtility.HtmlEncode(src)).Append("\" alt=\"").Append(rot).Append("\" data-rc-img />");
            sb.Append("<svg viewBox=\"").Append(vb).Append("\" preserveAspectRatio=\"none\">");
            if (j.ContornoApp is not null) sb.Append("<path class=\"rc-c-app\" d=\"").Append(j.ContornoApp).Append("\"/>");
            if (j.ContornoRl is not null) sb.Append("<path class=\"rc-c-rl\" d=\"").Append(j.ContornoRl).Append("\"/>");
            if (imovel) sb.Append("<path class=\"rc-c-imovel\" d=\"").Append(j.ContornoPrincipal).Append("\"/>");
            else
            {
                if (j.ContornoImovel is not null) sb.Append("<path class=\"rc-c-imovel\" d=\"").Append(j.ContornoImovel).Append("\"/>");
                sb.Append("<path class=\"rc-c-area\" d=\"").Append(j.ContornoPrincipal).Append("\"/>");
            }
            sb.Append("</svg></div><figcaption>").Append(System.Net.WebUtility.HtmlEncode(rot)).Append("</figcaption></figure>");
        }
        sb.Append("</div></div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }

    private Microsoft.AspNetCore.Html.IHtmlContent LegendaClasses(List<LinhaClasse> classes)
    {
        var sb = new System.Text.StringBuilder("<div class=\"rc-legenda rc-legenda--classes\">");
        foreach (var c in classes.Take(14))
            sb.Append("<span><i style=\"background:").Append(c.Cor).Append("\"></i>").Append(System.Net.WebUtility.HtmlEncode(c.Nome)).Append("</span>");
        sb.Append("<span><i class=\"rc-l-imovel\"></i>Limite do imóvel</span><span><i class=\"rc-l-area\"></i>Área convertida</span><span><i class=\"rc-l-rl\"></i>Reserva Legal</span></div>");
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    }
}
