@model DadosTela?
@{
    ViewData["Title"] = "Clima · Base de dados";
    var q = Model?.Qualidade;
    var c = Model?.Correcao;
    var ensoErrado = q?.PorTipo.GetValueOrDefault("ENSO_INCONSISTENTE") ?? 0;
    var tipos = new[] { "ENSO_INCONSISTENTE", "FORA_DO_PADRAO", "VALOR_IMPOSSIVEL", "MES_FALTANDO", "DUPLICADO" };
    var icones = new Dictionary<string, string>
    {
        ["ENSO_INCONSISTENTE"] = "waves", ["FORA_DO_PADRAO"] = "priority_high", ["VALOR_IMPOSSIVEL"] = "block",
        ["MES_FALTANDO"] = "event_busy", ["DUPLICADO"] = "content_copy",
    };
    const int Limite = 300;
}
<div class="cert-modulo clima-modulo">
    <partial name="_RecursosClima" />

    @if (c is not null)
    {
        @if (c.Simulacao)
        {
            <div class="cm-alerta cm-alerta--info" role="status">@Html.Icone("science")
                <div>
                    <b>Simulação:</b> @c.RegistrosACorrigir registro(s) teriam o ENSO recalculado a partir do ONI. Nada foi gravado.
                    @if (c.RegistrosACorrigir > 0)
                    {
                        <form method="post" action="/clima/dados/corrigir-enso" class="cl-inline" data-confirmar="Gravar a correção do ENSO em @c.RegistrosACorrigir registro(s) da tabela dados_climaticos?">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="aplicar" value="true" />
                            <button type="submit" class="cm-btn cm-btn--primario cm-btn--pequeno" data-carregando="Gravando...">@Html.Icone("done_all") Aplicar correção</button>
                        </form>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="cm-alerta cm-alerta--ok" role="status">@Html.Icone("check_circle")<div>@c.RegistrosCorrigidos registro(s) corrigidos. A previsão já usa os dados novos.</div></div>
        }
    }

    @if (q is not null)
    {
        <section class="cm-indicadores">
            <div class="cm-card cm-indicador">
                <div class="cm-indicador__topo"><span>Registros mensais</span>@Html.Icone("storage")</div>
                <div class="cm-indicador__valor">@q.Registros</div>
                <div class="cm-indicador__sub">@q.Periodo</div>
            </div>
            <div class="cm-card cm-indicador">
                <div class="cm-indicador__topo"><span>ENSO gravado errado</span>@Html.Icone("waves", ensoErrado > 0 ? "color:#d03b3b" : null)</div>
                <div class="cm-indicador__valor">@ensoErrado</div>
                <div class="cm-indicador__sub">fase/índice/intensidade diferente do ONI</div>
            </div>
            <div class="cm-card cm-indicador">
                <div class="cm-indicador__topo"><span>Valores fora do padrão</span>@Html.Icone("priority_high")</div>
                <div class="cm-indicador__valor">@(q.PorTipo.GetValueOrDefault("FORA_DO_PADRAO") + q.PorTipo.GetValueOrDefault("VALOR_IMPOSSIVEL"))</div>
                <div class="cm-indicador__sub">conferir na fonte (estação/planilha)</div>
            </div>
            <div class="cm-card cm-indicador">
                <div class="cm-indicador__topo"><span>Meses faltando / duplicados</span>@Html.Icone("event_busy")</div>
                <div class="cm-indicador__valor">@(q.PorTipo.GetValueOrDefault("MES_FALTANDO") + q.PorTipo.GetValueOrDefault("DUPLICADO"))</div>
                <div class="cm-indicador__sub">buracos na série atrapalham o ciclo</div>
            </div>
        </section>

        <section class="cm-card cl-card cl-acao-enso">
            <div>
                <h2>Corrigir o ENSO da base</h2>
                <p class="cm-ajuda">
                    Recalcula <code>enso_fase</code>, <code>enso_indice</code> e <code>enso_intensidade</code> a partir do ONI com sinal
                    (<code>correcao_fatores_climaticos</code>). Primeiro simule; depois aplique.
                </p>
            </div>
            <form method="post" action="/clima/dados/corrigir-enso">
                @Html.AntiForgeryToken()
                <input type="hidden" name="aplicar" value="false" />
                <button type="submit" class="cm-btn cm-btn--contorno" disabled="@(ensoErrado == 0)">@Html.Icone("science") Simular correção</button>
            </form>
        </section>

        <section class="cm-card cm-tabela-wrap">
            <div class="cl-card__cab cl-card__cab--pad"><h2>Problemas encontrados</h2><span class="cm-contador">@q.TotalProblemas no total@(q.TotalProblemas > Limite ? $" · mostrando {Limite}" : "")</span></div>
            <div class="cm-tabela-scroll">
                <table class="cm-tabela cl-tabela">
                    <thead><tr><th>Mês</th><th>Tipo</th><th>Detalhe</th><th class="cl-num">Id</th></tr></thead>
                    <tbody>
                        @if (q.Problemas.Count == 0)
                        {
                            <tr><td colspan="4" class="cm-tabela__vazio">@Html.Icone("check_circle", "color:#0ca30c;vertical-align:-5px") Nenhum problema na base.</td></tr>
                        }
                        @foreach (var pr in q.Problemas.OrderBy(x => Array.IndexOf(tipos, x.Tipo)).ThenBy(x => x.Ano).ThenBy(x => x.Mes).Take(Limite))
                        {
                            <tr>
                                <td class="cl-nowrap"><b>@MesAno(pr.Mes, pr.Ano)</b></td>
                                <td class="cl-nowrap">@Html.Icone(icones.GetValueOrDefault(pr.Tipo, "info"), "font-size:17px;vertical-align:-4px;color:#52514e") @NomeProblema(pr.Tipo)</td>
                                <td>@pr.Detalhe</td>
                                <td class="cl-num">@(pr.Id?.ToString() ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
<partial name="_ScriptsClima" />
