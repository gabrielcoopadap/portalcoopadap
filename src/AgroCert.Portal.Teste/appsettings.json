{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "AgroCert": "Host=localhost;Port=5432;Database=agrocert;Username=postgres"
  },

  "Autenticacao": {
    "Habilitada": false,
    "Modo": "Telas",
    "UsuarioTeste": "GABRIEL HENRIQUE CORREA ANDRADE"
  },

  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "Domain": "coopadap.com.br",
    "TenantId": "<id do tenant da Coopadap>",
    "ClientId": "<id do app registrado no Entra ID>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc"
  },

  "Clima": {
    "ApiUrl": "http://localhost:3030",
    "TimeoutSegundos": 60,
    "Acesso": {
      "ExigirLogin": false,
      "Perfis": []
    }
  },

  "AgroCert": {
    "Banco": {
      "AplicarMigracoes": true,
      "CarregarDadosIniciais": true
    },
    "Acesso": {
      "ExigirLogin": false,
      "Perfis": []
    },
    "Cors": {
      "Origens": [ "http://localhost:4200" ]
    },
    "Uploads": {
      "Diretorio": "uploads",
      "TamanhoMaximoMb": 15
    },
    "Corredores": {
      "Pasta": "../../dados-corredores/resultado"
    },
    "Ambiental": {
      "MapBiomas": {
        "BaseUrl": "https://plataforma.alerta.mapbiomas.org/api/v2/graphql",
        "Email": "",
        "Senha": ""
      },
      "Sicar": {
        "BaseUrl": "https://api.car.gov.br",
        "ApiKey": ""
      },
      "CoberturaMapBiomas": {
        "Pasta": "../../dados-corredores"
      },
      "UnidadesConservacao": {
        "Pasta": "../../dados-ambiental/ucs",
        "RaioAmortecimentoM": 3000
      },
      "Copernicus": {
        "OAuthTokenUrl": "https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token",
        "StatisticsUrl": "https://sh.dataspace.copernicus.eu/api/v1/statistics",
        "ProcessUrl": "https://sh.dataspace.copernicus.eu/api/v1/process",
        "ClientId": "",
        "ClientSecret": ""
      }
    }
  }
}
